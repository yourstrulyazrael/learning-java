import java.util.ArrayList;
class Main {
    public static void main(String[] args) {
        VIP v = new VIP();
        int[] ages = {16, 21, 30, 42, 18, 36};

        v.req(ages);

    }
}

class VIP {
    public void req(int[] ages){
        int vip = 0;
        ArrayList<Integer> allowed = new ArrayList<>();
        for(int i = 0; i < ages.length; i++){   
            if(ages[i] >= 18 && ages[i] <= 35){
                allowed.add(ages[i]);
                vip++;
            }
                
        }
        System.out.println("Allowed Ages: " + allowed);
        System.out.println("Total VIPs allowed: " + vip);
        
    }
}
