import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        Robot r = new Robot();
        

        while(true){
            System.out.print("Task Cost: ");
            int task = input.nextInt();
            r.monitor(task);
            
        }
        
    }
}

class Robot{
    int battery = 100;
    int completed = 0;
    public void monitor(int task){
        if(battery - task < 20 || completed >= 5){
            System.out.println("Cannot accept tasks at this time.");
        }else{
            completed++;
            battery -= task;
        }

        System.out.println("Tasks completed: " + completed);
        System.out.println("Remaining battery: " + battery + "%");
    }
}
