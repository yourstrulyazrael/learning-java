class Main {
    public static void main(String[] args) {
        Discount d = new Discount();
        int [] prices = {500, 1000, 1500, 800, 2000};

        System.out.println(d.discount(prices));
    }
}

class Discount{
    public int discount(int[] arr){
        int sum = 0;
        for(int i = 0; i < arr.length; i++){
            if(arr[i] >= 1000){
                double discount = arr[i] * 0.90;
                sum += discount;
            }else{
                sum += arr[i];
            }
        }

        return sum;
    }
}
