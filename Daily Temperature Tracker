class Main {
    public static void main(String[] args) {
        TempChecker t = new TempChecker();
        int[] temps = {72, 78, 71, 85, 74};

        t.tempchr(temps);
            

    }
}

class TempChecker{
    public void tempchr(int[] arr){
        int highest = arr[0];
        for(int i = 0; i < arr.length; i++){
            if(arr[i] > highest){
                highest = arr[i];
            }
        }
        System.out.println("Highest Temperature: " + highest);
    }
}
