class Main {
    public static void main(String[] args) {
        GradesChecker g = new GradesChecker();
        int [] grades = {80, 65, 90, 70, 75};

        int[] result = g.checker(grades);

        System.out.println("Passed: " + result[0]);
        System.out.println("Passed: " + result[1]);
        
    }
}

class GradesChecker{
    public int[] checker(int[] arr){
        int passed = 0;
        int failed = 0;
        for(int i = 0; i < arr.length; i++){
            if(arr[i] >= 75){
                passed++;
            }else{
                failed++;
            }
        }
        return new int[]{passed, failed};
    }
}
